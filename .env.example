# ---------------------------------------------------
# IRC Taxi booking site — configuration
# Copy this file to ".env" and fill in real values.
# ".env" is where the driver's real phone/email live —
# never commit it, only .env.example.
# ---------------------------------------------------

# Port the server runs on locally
PORT=3000

# ---- WhatsApp ----
# The number that receives booking requests via WhatsApp.
# Country code, no +, no spaces, no leading 0.
# e.g. Rwanda number 0780 557 704 -> 250780557704
WHATSAPP_NUMBER=250780557704

# ---- Email (used when a customer chooses "Email" on the form) ----
# The inbox that should receive booking requests.
RECIPIENT_EMAIL=owner@example.com

# SMTP credentials used to SEND that email.
# Easiest option: a Gmail account with a 16-character "App Password"
# (Google Account -> Security -> 2-Step Verification -> App passwords).
# Do NOT use your normal Gmail password here.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your-sending-account@gmail.com
SMTP_PASS=your-16-character-app-password
