# ---------------------------------------------------
# IRC Taxi booking site — configuration
# Copy this file to ".env" and fill in real values.
# ".env" is where the driver's real number lives —
# never commit it, only .env.example.
# ---------------------------------------------------

# Port the server runs on locally
PORT=3000

# ---- WhatsApp ----
# The number that receives every booking request.
# Country code, no +, no spaces, no leading 0.
# e.g. Rwanda number 0780 557 704 -> 250780557704
WHATSAPP_NUMBER=250780557704
